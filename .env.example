# Copy to .env and fill in.
NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
API_PREFIX=/api
SEED_ON_START=true

JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=30d
BCRYPT_ROUNDS=10

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=clubdb

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=6h

MAX_VIDEO_MB=200
MAX_IMAGE_MB=25
MAX_AUDIO_MB=20
POST_VIDEO_SECONDS=300
STORY_SECONDS=15
LIVE_SECONDS=600
CALL_RING_SECONDS=45
NOTIFICATION_DAYS=30
